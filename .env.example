# Google OAuth credentials for Auth.js (NextAuth.js v5)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Optional: set the canonical URL when Auth.js cannot infer it.
# AUTH_URL=http://localhost:3000

# Optional for trusted reverse-proxy deployments when host detection requires it.
# AUTH_TRUST_HOST=true
